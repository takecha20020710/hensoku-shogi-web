diff --git a/source/eval/material/evaluate_material.cpp b/source/eval/material/evaluate_material.cpp
index d4d7715..59d8ace 100644
--- a/source/eval/material/evaluate_material.cpp
+++ b/source/eval/material/evaluate_material.cpp
@@ -5,6 +5,7 @@
 #include "../../types.h"
 #include "../../position.h"
 #include "../../evaluate.h"
+#include "../../usioption.h"
 
 // パラメーターの自動調整フレームワーク
 #include <array>
@@ -27,12 +28,374 @@ namespace Eval {
 	// これでも3990XだとR2300ぐらいある。
 	// (序盤を定跡などでうまく乗り切れれば)
 
-	void add_options(OptionsMap&, ThreadPool&) {}
-	Value compute_eval(const Position& pos) {
+	// 評価実験はUSIオプションで段階的に分離する。
+	// VariantHomeAttackEval=false で攻撃型v2へ戻せる。
+	// VariantPawnEval=true, VariantAttackEval=false で歩評価v1へ戻せる。
+	// VariantAttackEvalとVariantPawnEvalが両方falseなら従来評価へ戻る。
+	bool variant_pawn_eval_enabled = true;
+	bool variant_attack_eval_enabled = true;
+	bool variant_home_attack_eval_enabled = true;
+
+	using ProximityTable = std::array<std::array<uint8_t, SQ_NB>, SQ_NB>;
+
+	constexpr ProximityTable make_proximity_table(int max_distance)
+	{
+		ProximityTable table{};
+		for (int king = 0; king < int(SQ_NB); ++king)
+			for (int sq = 0; sq < int(SQ_NB); ++sq)
+			{
+				const int distance = dist(Square(sq), Square(king));
+				table[king][sq] = uint8_t(distance <= max_distance
+					? max_distance + 1 - distance : 0);
+			}
+		return table;
+	}
+
+	static constexpr auto king_proximity4 = make_proximity_table(4);
+	static constexpr auto king_proximity5 = make_proximity_table(5);
+
+	// 二歩のない筋を9回のBitboard交差で探す代わりに、
+	// 歩打ち可能マスクを9bitの筋マスクへ圧縮して最短距離を求める。
+	FORCE_INLINE int closest_open_file(const Bitboard& board_pawns, File target_file)
+	{
+#if defined(USE_BMI2)
+		const Bitboard open_files_bb = pawn_drop_mask<BLACK>(board_pawns);
+		const Bitboard rank5 = rank_bb(RANK_5);
+		const uint16_t open_files = uint16_t(
+			PEXT64(open_files_bb.extract64<0>(), rank5.extract64<0>())
+			| (PEXT64(open_files_bb.extract64<1>(), rank5.extract64<1>()) << 7));
+
+		if (!open_files)
+			return 9;
+
+		const int target = int(target_file);
+		int closest = 9;
+		const uint16_t lower = open_files & uint16_t((1u << (target + 1)) - 1);
+		if (lower)
+			closest = target - (31 - __builtin_clz(unsigned(lower)));
+		const uint16_t upper = open_files >> target;
+		if (upper)
+			closest = (std::min)(closest, __builtin_ctz(unsigned(upper)));
+		return closest;
+#else
+		int closest = 9;
+		for (int file_index = int(FILE_1); file_index < int(FILE_NB); ++file_index)
+		{
+			if (board_pawns & file_bb(File(file_index)))
+				continue;
+			closest = (std::min)(closest, std::abs(file_index - int(target_file)));
+		}
+		return closest;
+#endif
+	}
+
+	void add_options(OptionsMap& options, ThreadPool&)
+	{
+		options.add("VariantPawnEval", Option(true, [](const Option& option) {
+			variant_pawn_eval_enabled = int64_t(option) != 0;
+			return std::nullopt;
+		}));
+		options.add("VariantAttackEval", Option(true, [](const Option& option) {
+			variant_attack_eval_enabled = int64_t(option) != 0;
+			return std::nullopt;
+		}));
+		options.add("VariantHomeAttackEval", Option(true, [](const Option& option) {
+			variant_home_attack_eval_enabled = int64_t(option) != 0;
+			return std::nullopt;
+		}));
+	}
+
+	// 歩に関する実験評価だけを先手視点の値で返す。
+	// 持ち駒1枚・2枚そのものには加点減点せず、持ち歩の「打ちやすさ」だけを見る。
+	Value variant_pawn_score(const Position& pos)
+	{
+		const auto color_score = [&](Color color) {
+			int score = 0;
+			const Color opponent = ~color;
+			const File opponent_king_file = file_of(pos.square<KING>(opponent));
+
+			// 序盤ほど、相手玉のいる筋の歩を前へ進める。
+			// 24手目までなだらかに弱めることで、評価の急変を避ける。
+			const int opening_scale = (std::max)(0, 24 - pos.game_ply());
+			if (opening_scale > 0)
+			{
+				// 二歩の規則上、この筋の不成歩は最大1枚。全歩を走査しない。
+				Bitboard pawns = pos.pieces(color, PAWN) & file_bb(opponent_king_file);
+				if (pawns)
+				{
+					const Square sq = pawns.pop();
+					const int advance = color == BLACK
+						? (std::max)(0, int(RANK_7) - int(rank_of(sq)))
+						: (std::max)(0, int(rank_of(sq)) - int(RANK_3));
+					score += advance * 28 * opening_scale / 24;
+				}
+			}
+
+			// 二歩で歩を打てる筋が限られる場合、持ち歩の使いにくさを評価する。
+			// 持ち歩の枚数では倍率を変えないため、1枚と2枚の差は評価しない。
+			if (hand_count(pos.hand_of(color), PAWN) > 0)
+			{
+				const Bitboard board_pawns = pos.pieces(color, PAWN);
+				const int open_file_distance = closest_open_file(board_pawns, opponent_king_file);
+
+				// 相手玉の筋へすぐ打てるなら減点なし。離れるほど使いにくい。
+				static constexpr int unusable_pawn_penalty[10] = {
+					0, 30, 55, 75, 90, 90, 90, 90, 90, 130
+				};
+				score -= unusable_pawn_penalty[open_file_distance];
+			}
+
+			return score;
+		};
+
+		return color_score(BLACK) - color_score(WHITE);
+	}
+
+	// 攻撃型v2の評価。駒価値や持ち駒枚数そのものは変更しない。
+	// 昨日の歩評価より玉頭の位取りを強くし、攻めがない場合だけ囲いを次善とする。
+	Value variant_attack_score(const Position& pos)
+	{
+		const auto color_score = [&](Color color) {
+			int score = 0;
+			const Color opponent = ~color;
+			const Square opponent_king = pos.square<KING>(opponent);
+			const Square own_king = pos.square<KING>(color);
+			const File opponent_king_file = file_of(opponent_king);
+
+			// 玉頭の歩は「1マスずつ同じ価値」ではなく、五段目の位まで進むほど
+			// 評価を大きくする。20手目までは100%、以後は緩やかに弱める。
+			static constexpr int king_file_pawn_bonus[7] = {
+				0, 95, 230, 350, 430, 480, 520
+			};
+			const int game_ply = pos.game_ply();
+			const int opening_percent = game_ply <= 20
+				? 100
+				: (std::max)(40, 100 - (game_ply - 20) * 3);
+			Bitboard king_file_pawns = pos.pieces(color, PAWN) & file_bb(opponent_king_file);
+			if (king_file_pawns)
+			{
+				const Square sq = king_file_pawns.pop();
+				const int advance = color == BLACK
+					? (std::max)(0, int(RANK_7) - int(rank_of(sq)))
+					: (std::max)(0, int(rank_of(sq)) - int(RANK_3));
+				score += king_file_pawn_bonus[(std::min)(advance, 6)] * opening_percent / 100;
+			}
+
+			// 持ち歩は「枚数」ではなく、相手玉付近へすぐ打てるかだけを見る。
+			// 歩を取る駒得は180なので、遠い筋にしか打てない歩はそれを上回って減点し、
+			// 使える歩を取る手だけが駒得として残るようにする。
+			if (hand_count(pos.hand_of(color), PAWN) > 0)
+			{
+				const Bitboard board_pawns = pos.pieces(color, PAWN);
+				const int open_file_distance = closest_open_file(board_pawns, opponent_king_file);
+				static constexpr int unusable_pawn_penalty[10] = {
+					0, 65, 125, 180, 215, 225, 225, 225, 225, 270
+				};
+				score -= unusable_pawn_penalty[open_file_distance];
+			}
+
+			// 相手玉へ近づく攻め駒を評価する。盤上全体の利き計算は行わず、
+			// 攻撃参加に関係する駒だけを見ることで探索速度を保つ。
+			const auto& proximity4 = king_proximity4[opponent_king];
+			const auto& proximity5 = king_proximity5[opponent_king];
+			const auto add_king_proximity = [&](PieceType pt, int weight, const auto& proximity) {
+				Bitboard pieces = pos.pieces(color, pt);
+				while (pieces)
+				{
+					const Square sq = pieces.pop();
+					score += proximity[sq] * weight;
+				}
+			};
+			add_king_proximity(SILVER, 18, proximity4);
+			add_king_proximity(KNIGHT, 13, proximity4);
+			add_king_proximity(PRO_SILVER, 22, proximity4);
+			add_king_proximity(PRO_KNIGHT, 22, proximity4);
+			add_king_proximity(PRO_PAWN, 24, proximity4);
+			add_king_proximity(PRO_LANCE, 22, proximity4);
+			add_king_proximity(HORSE, 18, proximity5);
+			add_king_proximity(DRAGON, 20, proximity5);
+
+			// 大駒が相手玉と同じ筋・段・斜線へ移ることを攻撃準備として評価する。
+			Bitboard bishops = pos.pieces(color, BISHOP);
+			while (bishops)
+			{
+				const Square sq = bishops.pop();
+				const int file_distance = std::abs(int(file_of(sq)) - int(opponent_king_file));
+				const int rank_distance = std::abs(int(rank_of(sq)) - int(rank_of(opponent_king)));
+				if (file_distance == rank_distance)
+					score += 32;
+			}
+			Bitboard rooks = pos.pieces(color, ROOK);
+			while (rooks)
+			{
+				const Square sq = rooks.pop();
+				if (file_of(sq) == opponent_king_file || rank_of(sq) == rank_of(opponent_king))
+					score += 38;
+			}
+
+			// 攻めが成立しない局面でだけ選ばれる程度の、小さな囲い評価。
+			// 自玉2マス以内の金銀を数え、攻撃評価より十分弱くする。
+			Bitboard defenders = pos.pieces(color, GOLD, SILVER);
+			const auto& own_king_proximity = king_proximity4[own_king];
+			while (defenders)
+			{
+				const Square sq = defenders.pop();
+				const int proximity = own_king_proximity[sq];
+				if (proximity >= 3)
+					score += proximity == 4 ? 11 : 5;
+			}
+
+			// 12香・92香型の待ち手を抑える。玉側の端攻め、歩を進めた筋、
+			// 歩がなく香が直ちに働ける筋は例外として残す。
+			Bitboard lances = pos.pieces(color, LANCE);
+			while (lances)
+			{
+				const Square sq = lances.pop();
+				const Rank rank = rank_of(sq);
+				const bool one_step_wait = color == BLACK ? rank == RANK_8 : rank == RANK_2;
+				if (!one_step_wait)
+					continue;
+
+				const File file = file_of(sq);
+				const int king_file_distance = std::abs(int(file) - int(opponent_king_file));
+				Bitboard same_file_pawns = pos.pieces(color, PAWN) & file_bb(file);
+				bool pawn_cleared_or_advanced = !same_file_pawns;
+				if (same_file_pawns)
+				{
+					const Square pawn_sq = same_file_pawns.pop();
+					const int pawn_advance = color == BLACK
+						? (std::max)(0, int(RANK_7) - int(rank_of(pawn_sq)))
+						: (std::max)(0, int(rank_of(pawn_sq)) - int(RANK_3));
+					pawn_cleared_or_advanced = pawn_advance >= 2;
+				}
+
+				if (king_file_distance > 1 && !pawn_cleared_or_advanced)
+					score -= 105;
+			}
+
+			return score;
+		};
+
+		return color_score(BLACK) - color_score(WHITE);
+	}
+
+	// 居玉・左右歩攻めv3の評価。v2へ加算する独立項にして、すぐ戻せるようにする。
+	// 自玉は序盤ほど初期位置に残し、相手が居玉なら4筋・6筋の歩攻めを優先する。
+	Value variant_home_attack_score(const Position& pos)
+	{
+		const auto color_score = [&](Color color) {
+			int score = 0;
+			const Color opponent = ~color;
+			const Square own_king = pos.square<KING>(color);
+			const Square opponent_king = pos.square<KING>(opponent);
+			const Square own_home = color == BLACK ? SQ_59 : SQ_51;
+			const Square opponent_home = opponent == BLACK ? SQ_59 : SQ_51;
+			const int game_ply = pos.game_ply();
+
+			// 40手目までは居玉を強く維持する。以後も急に評価を消さず、
+			// 終盤の必要な玉移動を妨げない程度までなだらかに弱める。
+			const int home_percent = game_ply <= 40
+				? 100
+				: (std::max)(20, 100 - (game_ply - 40) * 4);
+			if (own_king == own_home)
+				score += 180 * home_percent / 100;
+			else
+			{
+				// 4二玉・6二玉（先手なら4八玉・6八玉）のように一段上がる手は、
+				// 相手の歩攻めの目標を作るため、横移動よりさらに強く抑える。
+				const int forward = (std::max)(0,
+					int(RANK_9) - int(relative_rank(color, rank_of(own_king))));
+				score -= (std::min)(forward, 3) * 75 * home_percent / 100;
+			}
+
+			// 相手玉が初期位置にいるとき、玉の両隣（4筋・6筋）の歩を進め、
+			// 6六歩・同歩・6七歩型（左右反転を含む）で歩を渡す攻めを評価する。
+			if (opponent_king == opponent_home)
+			{
+				static constexpr int side_pawn_bonus[7] = {
+					0, 70, 205, 330, 420, 480, 520
+				};
+				const int attack_percent = game_ply <= 40
+					? 100
+					: (std::max)(40, 100 - (game_ply - 40) * 3);
+
+				// 後手が攻める場合は4筋が相手飛車側、6筋が相手角側。
+				// 先手では盤面を反転した6筋・4筋がそれぞれに対応する。
+				const File rook_side_file = color == BLACK ? FILE_6 : FILE_4;
