+	// 歩に関する実験評価だけを先手視点の値で返す。
+	// 持ち駒1枚・2枚そのものには加点減点せず、持ち歩の「打ちやすさ」だけを見る。
+	Value variant_pawn_score(const Position& pos)
+	{
+		const auto color_score = [&](Color color) {
+			int score = 0;
+			const Color opponent = ~color;
+			const File opponent_king_file = file_of(pos.square<KING>(opponent));
+
+			// 序盤ほど、相手玉のいる筋の歩を前へ進める。
