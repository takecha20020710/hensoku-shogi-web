+
+			// 大駒が相手玉と同じ筋・段・斜線へ移ることを攻撃準備として評価する。
+			Bitboard bishops = pos.pieces(color, BISHOP);
+			while (bishops)
+			{
+				const Square sq = bishops.pop();
+				const int file_distance = std::abs(int(file_of(sq)) - int(opponent_king_file));
+				const int rank_distance = std::abs(int(rank_of(sq)) - int(rank_of(opponent_king)));
